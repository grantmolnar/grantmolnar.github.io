    {
      "sequence": 152,
      "operation_number": 51,
      "type": "visit_note_recorded",
      "visit_number": 14,
      "text": "Maelith and Serevin reaffirmed the corrected text. Serathiel received the eight-day schedule. Vaudren received the title “The Crown and Concord of Aurelune for the Restoration of Orison.” Theron certified seven seasonal seals without adding Eiral’s banner. Only then did Caelir join for the term, shared credit, and bounded protective authority."
    },
    {
      "sequence": 153,
      "operation_number": 52,
      "type": "encounter_consequence_recorded",
      "encounter_id": "the-crown-conclave",
      "text": "The final seven seals are Maelith, Serathiel, Vaudren, Orelle, Namaris, Thalan, and Serevin. Spring, Summer, Autumn, and Winter stand together without Eiral or the Ashen Bough."
    },
    {
      "sequence": 154,
      "operation_number": 53,
      "type": "encounter_consequence_recorded",
      "encounter_id": "the-twilight-laurel-apartments",
      "text": "Theron Eiral certifies the valid petition in office. House Eiral remains unsealed and gains no claim to have furnished the majority."
    },
    {
      "sequence": 155,
      "operation_number": 54,
      "type": "encounter_consequence_recorded",
      "encounter_id": "the-crown-conclave",
      "text": "Certification precedes royal joinder. Caelir joins for an eight-day term, shared Crown-and-Concord credit, and explicit protective authority confined to damage and use beyond the undertaking."
    },
    {
      "sequence": 156,
      "operation_number": 55,
      "type": "encounter_consequence_recorded",
      "encounter_id": "the-unfurling-branch",
      "text": "Ilyrion supports the Sunseed’s departure and publicly opposes the refusal to recognize Orison as an equal co-custodian. The recognition campaign leaves the hall unfinished rather than defeated."
    },
    {
      "sequence": 157,
      "operation_number": 56,
      "type": "encounter_consequence_recorded",
      "encounter_id": "the-ashen-bough-hearing",
      "text": "The Ashen Bough remains vacant at departure. Neither Mirath’s blood claim, Aven’s adoption claim, nor a temporary regency is made constitutional doctrine under emergency pressure."
    },
    {
      "sequence": 158,
      "operation_number": 57,
      "type": "encounter_consequence_recorded",
      "encounter_id": "the-crown-conclave",
      "text": "Tamsin Rook and Captain Naevra Sol take joint physical custody. Mara Venn accepts the undertaking while retaining Orison’s civil refusal right. The Sunseed leaves Aurelune before the last safe departure."
    }
