      "visit_number": 8
    },
    {
      "sequence": 96,
      "operation_number": 31,
      "type": "visit_note_recorded",
      "visit_number": 8,
      "text": "The war table produced a scheme in which everyone could stop the expedition and no one could move it. Garran yielded supreme command to Ysandre only after custody, guard, field command, civil refusal, and protective authority were separated into powers that could be obeyed together."
    },
    {
      "sequence": 97,
      "operation_number": 32,
      "type": "revelation_established",
      "revelation_id": "house-eiral-can-seal-for-a-governable-concord",
      "supporting_clue_ids": [
        "a-divided-command-that-can-still-move"
