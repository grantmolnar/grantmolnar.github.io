    {
      "sequence": 107,
      "operation_number": 34,
      "type": "visit_note_recorded",
      "visit_number": 9,
      "text": "Nara reduced Orelle’s three-million-crown figure to verified unrecoverable exposure. The delegation accepted divided guarantees, ordinary reconstruction contracts, and funded wards and reserve pay, while refusing exclusive customs rights and an indemnity with no ceiling."
    },
    {
      "sequence": 108,
      "operation_number": 35,
      "type": "encounter_consequence_recorded",
      "encounter_id": "the-golden-sheaf-exchange",
      "text": "Orelle gives a conditional declaration and begins spending under bounded contracts before the vote. Wardstones and reserve pay become enacted preparation rather than promises that spring into existence after victory."
    },
    {
      "sequence": 109,
      "operation_number": 36,
      "type": "encounter_visited",
