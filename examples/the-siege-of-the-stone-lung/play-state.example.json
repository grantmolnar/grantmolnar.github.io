    {
      "sequence": 82,
      "operation_number": 33,
      "type": "visit_note_recorded",
      "visit_number": 10,
      "text": "The Hand returned by three roads. Orren and Tamar held the crown; Siva placed tracers and refuge teams along the surviving overflow; Hadrik and Rusk isolated Bas; Maela matched Brann's withdrawal to Ilyra's valve orders."
    },
    {
      "sequence": 83,
      "operation_number": 34,
      "type": "encounter_consequence_recorded",
      "encounter_id": "the-shattered-gate",
      "text": "The outer gate falls on the second release. Brann withdraws in order after buying the minutes required below, and no Host formation reaches an occupied ward before Venn's truce signal."
    },
    {
      "sequence": 84,
      "operation_number": 35,
      "type": "encounter_consequence_recorded",
      "encounter_id": "the-stone-lung",
      "text": "Heartstrike is detuned. Black breath vents through the surviving overflow, and the southern branch reopens by measured stages under witnesses from Kest Mourne and Lorn."
    },
    {
      "sequence": 85,
      "operation_number": 36,
      "type": "encounter_consequence_recorded",
      "encounter_id": "the-lantern-court",
      "text": "Six civic lanterns burn evenly after the retuning. Ilyra sets a seventh unlit lantern beside them for Lorn until permanent controls, reparations, and responsibility for the closure are settled."
    }
