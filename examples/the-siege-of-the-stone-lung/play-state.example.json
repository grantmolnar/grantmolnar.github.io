      "sequence": 79,
      "operation_number": 31,
      "type": "visit_note_recorded",
      "visit_number": 9,
      "text": "The Hand returned with the conduit plate, Edda's minutes, Bas's yield table, and a staged retuning sequence. Ilyra read the city's act aloud, ordered the lower wards evacuated, moved Brann's reserve to the Lung, and offered Venn joint control if she stopped Bas."
    },
    {
      "sequence": 80,
      "operation_number": 32,
      "type": "encounter_consequence_recorded",
      "encounter_id": "the-lantern-court",
      "text": "Kest Mourne acknowledges the sealed branch, orders a bounded evacuation, and authorizes temporary joint control of the southern valves with Lorn."
    },
    {
      "sequence": 81,
